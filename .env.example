# SkyGuard AI - Production Environment Variables Template
# Copy this file to .env and fill in your SendGrid credentials.

SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=alerts@yourproject.com
ALERT_EMAIL_TO=operator@example.com

# Live Open-Meteo Configuration
LIVE_METEO_ENABLED=true
LIVE_POLL_INTERVAL_SECONDS=300
OPEN_METEO_TIMEOUT_SECONDS=10
LIVE_ALERT_COOLDOWN_SECONDS=1800
